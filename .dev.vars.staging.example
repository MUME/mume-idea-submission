# Copy to .dev.vars.staging and fill with the STAGING Discord app + server values.
# This is a completely separate set from .dev.vars (the live instance).
# The ops scripts read this file when you set MUME_ENV_FILE=.dev.vars.staging.

# Staging worker URL (also set the same value in wrangler.toml [env.staging.vars]).
PUBLIC_BASE_URL=https://mume-idea-submission-staging.mark-smith-1f9.workers.dev

# From the STAGING Discord application (a second app, not the live one).
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# The staging server + its channels/role.
DISCORD_GUILD_ID=
FORUM_CHANNEL_ID=
SUBMIT_CHANNEL_ID=
EXPORT_CHANNEL_ID=
COUNCIL_ROLE_ID=

# Generate fresh ones for staging (openssl rand -hex 32) — don't reuse the live values.
SESSION_SIGNING_KEY=
ADMIN_TOKEN=
